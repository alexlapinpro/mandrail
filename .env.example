# Copy to .env and fill in. Never commit .env.

# Chain (BSC testnet)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
LOGS_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# BSC mainnet, read-only: Atlas price feeds
BSC_MAINNET_RPC_URL=https://bsc-rpc.publicnode.com
# Etherscan V2 API key (contract verification)
BSCSCAN_API_KEY=

# Server-side keys (testnet only, never expose to the client)
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
CHALLENGE_AGENT_PRIVATE_KEY=
CHALLENGE_MANDATE_ID=
ATTEST_SECRET=

# In-app price loop: "on" for the hosted app, empty locally
ATTESTER_LOOP=

# CoinMarketCap Pro API
CMC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Public (client)
NEXT_PUBLIC_CHAIN_ID=97
