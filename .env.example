# Copy to .env and fill in. Never commit .env.

# Chain (BSC testnet)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Needs full log history. publicnode keeps only a few hours of logs, so after a restart
# the feed loses older decisions. A free NodeReal key works: https://bsc-testnet.nodereal.io/v1/<key>
LOGS_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# BSC mainnet, read-only: Atlas price feeds
BSC_MAINNET_RPC_URL=https://bsc-rpc.publicnode.com
# Etherscan V2 API key (contract verification)
BSCSCAN_API_KEY=

# Server-side keys (testnet only, never expose to the client)
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
CHALLENGE_AGENT_PRIVATE_KEY=
ATTEST_SECRET=

# Addresses of the presenters, comma separated. Each has its own daily reserve that strangers cannot use up
DEMO_OWNERS=
# Header with the visitor's address. Empty = x-real-ip on Railway, else the last hop of x-forwarded-for. Check /api/health?ip after deploying
CLIENT_IP_HEADER=

# Optional: public URL of the hosted app, written into the ERC-8004 agent card
APP_URL=
# Only for the read-only mainnet check (costs real BNB, contracts/script/DeployAtlasCheck.s.sol)
MAINNET_DEPLOYER_PRIVATE_KEY=

# In-app price loop: "on" for the hosted app, empty locally
ATTESTER_LOOP=

# CoinMarketCap Pro API
CMC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Public (client)
NEXT_PUBLIC_CHAIN_ID=97
